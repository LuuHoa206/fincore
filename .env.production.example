# Copy to .env.production on the deployment host. Never commit that real file.
POSTGRES_DB=fincore
POSTGRES_USER=fincore_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# Generate a separate value with at least 32 random bytes for every environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=fincore-api
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# The public HTTPS origin used by browsers. Do not include a trailing slash.
CORS_ALLOWED_ORIGINS=https://fincore.example.com

# Docker serves React and proxies /api/v1 to the private backend service.
VITE_API_BASE_URL=/api/v1
APP_PORT=8080

# Optional image overrides. The manual GitHub Actions release workflow supplies
# these values on the deployment host; keep the local defaults when building there.
# BACKEND_IMAGE=ghcr.io/your-github-owner/fincore-backend:stable
# WEB_IMAGE=ghcr.io/your-github-owner/fincore-web:stable

REQUEST_LOGGING_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW=PT1M
